# Copy to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=5001

# Registry DB — the only database URL the server needs (tenant URLs come
# from the registry's institutions.conn_string column)
REGISTRY_URL=postgres://USER:PASSWORD@HOST:5432/mobius_registry?sslmode=require

# Generate with: openssl rand -hex 64
JWT_SECRET=

CORS_ORIGIN=http://localhost:5173

# Email (Resend). Leave RESEND_API_KEY empty in dev/test — sends are skipped.
RESEND_API_KEY=
RESEND_FROM=
ADMIN_EMAIL=
