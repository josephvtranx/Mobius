{
  "root": true,
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "env": {
    "node": true,
    "browser": true,
    "es2022": true
  },
  "rules": {
    "no-restricted-globals": [
      "error",
      { "name": "Date", "message": "Use time.ts helpers instead" }
    ],
    "no-restricted-imports": ["error", { "patterns": ["moment"] }]
  }
}
